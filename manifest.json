{
  "manifest_version": 3,
  "name": "Concert Player",
  "version": "1.2.0",
  "description": "Crie uma seleção de músicas dentro de shows completos no YouTube.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Concert Player"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
